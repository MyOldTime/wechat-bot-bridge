# 使用 Docker Compose 前先把本文件复制为 .env。
# 请生成高熵随机值，绝不要提交真实密钥。
WBB_API_KEY=replace-with-a-long-random-secret

# 管理页面使用独立的 HTTP Basic Auth，不得与 API Key 共用。
WBB_WEB_USERNAME=admin
WBB_WEB_PASSWORD=replace-with-a-different-long-password
WBB_WEB_TOKEN_TTL_SECONDS=3600
WBB_WEB_TYPING_TIMEOUT_SECONDS=5

# Docker Compose 只向宿主机回环地址发布端口。
WBB_HOST=0.0.0.0
WBB_PORT=8000
WBB_HOST_PORT=8000
# 可选：critical / error / warning / info / debug / trace
WBB_LOG_LEVEL=info

# 容器持久化路径；docker-compose.yml 会把 ./data 映射到 /data。
WBB_DATA_DIR=/data
WBB_DATABASE_PATH=/data/wechat-bridge.db
WBB_CREDENTIALS_PATH=/data/wechat/credentials.json

# 可选的规范化入站消息转发。
# WBB_INBOUND_WEBHOOK_URL=https://example.internal/hooks/wechat
# WBB_INBOUND_WEBHOOK_SECRET=replace-with-a-different-random-secret
WBB_INBOUND_QUEUE_SIZE=1000
WBB_INBOUND_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
WBB_WEBHOOK_TIMEOUT_SECONDS=8
WBB_WEBHOOK_MAX_ATTEMPTS=3

# 同步发送内容上限。
WBB_MESSAGE_MAX_CHARS=16000
WBB_MEDIA_MAX_BYTES=20971520

# Docker 构建时使用的 uv/PyPI 镜像，可按需覆盖。
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
